rules_version = '2';
// ============================================================================
// قواعد الوصول — Firestore
//
// بعد إضافة Backend API (انظر مجلد backend/) أصبح هذا الـ Backend هو الوحيد
// المخوَّل للتحدث مع Firestore، عبر Firebase Admin SDK الذي يتجاوز هذه القواعد
// أصلاً (صلاحيات كاملة بغض النظر عنها). القواعد هنا تُقفل الوصول المباشر من
// أي متصفح/عميل تمامًا، لأنه لم يعد هناك أي سبب شرعي لذلك — كل القراءة
// والكتابة تمر عبر مصادقة JWT في الـ Backend الآن بدل كود وصول مشترك ظاهر
// للجميع في كود المصدر.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
