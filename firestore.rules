rules_version = '2';
// ============================================================================
// قواعد Firestore — نسخة الطيار (Pilot)
//
// هذه القواعد مفتوحة عمدًا (قراءة/كتابة للجميع) لأن هذا التطبيق لا يستخدم
// تسجيل دخول حقيقي (لا Firebase Auth) — تمامًا كما طُلب: بدون مصادقة معقّدة.
// معنى ذلك عمليًا: أي شخص يملك رابط التطبيق يمكنه تقنيًا قراءة كل الطلبات
// (بما فيها الملاحظات الداخلية للسفراء) حتى دون إدخال كود وصول السفراء —
// كود الوصول يخفي واجهة الاستخدام فقط، ولا يمنع الوصول للبيانات نفسها.
// لذلك: لا تُدخل بيانات سرية أو حساسة في أي طلب أو ملاحظة (نفس تنبيه النموذج).
//
// عند الانتقال لنظام إنتاجي حقيقي (V2)، استبدل هذه القواعد بمصادقة فعلية
// (Firebase Auth + قواعد تستند لهوية المستخدم) قبل إدخال أي بيانات حساسة.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
