# انسخ هٰا الملف إلى .env محليًا، أو عبّي نفس المتغيرات في إعدادات Render (Environment)
# لا تضع القيم الحقيقية هنا، ولا ترفع .env أبدًا للمستودع.

# بيانات حساب خدمة Firebase (Service Account) — من Firebase Console > Project settings > Service accounts > Generate new private key
# الصق محتوى ملف الـ JSON كامل كسطر واحد (escaped) أو استخدم FIREBASE_SERVICE_ACCOUNT_BASE64
FIREBASE_SERVICE_ACCOUNT_JSON=

# بديل: نفس الملف لكن مُرمّز base64 (أسهل لصق في Render)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# مفتاح سرّي عشوائي طويل لتوقيع جلسات الدخول (JWT) — ولّد واحد بـ: openssl rand -hex 32
JWT_SECRET=

# أصل الواجهة الأمامية المسموح له بالتواصل مع هذا الـ API (CORS)
FRONTEND_ORIGIN=https://ncgr-amb.com

# المنفذ (Render يحدده تلقائيًا عادة عبر PORT)
PORT=3000

# مفتاح مؤقت لحماية نقطة توليد كلمات المرور لمرة واحدة (/api/admin/seed-passwords)
# ولّد قيمة عشوائية، استخدمها مرة، ثم احذفها من متغيرات البيئة.
SETUP_KEY=
